{
  "workflow": "text_plate.api.json",
  "description": "Deterministic readable typography plate. With look = a Typeset look id (TypesetLook node) the plate takes that look's face, case, colours, card, halo and glow; with look = default the prompt picks neon/chrome colours. Not generative scene editing; LTX supplies motion downstream.",
  "inputs": {
    "frame": {
      "node": "1",
      "field": "image",
      "kind": "comfy_input_path"
    },
    "text": {
      "node": "2",
      "field": "text",
      "kind": "string"
    },
    "prompt": {
      "node": "2",
      "field": "prompt",
      "kind": "string",
      "default": "pink neon lettering"
    },
    "mask_png": {
      "node": "2",
      "field": "mask_png",
      "kind": "comfy_input_path",
      "optional": true
    },
    "look": {
      "node": "4",
      "field": "preset",
      "kind": "string",
      "default": "default",
      "optional": true
    }
  },
  "outputs": {
    "plate": {
      "node": "3",
      "type": "image"
    }
  }
}
