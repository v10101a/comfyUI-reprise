{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "typeset/test/person_short.mp4"
    }
  },
  "2": {
    "class_type": "BiRefNetRMBG",
    "inputs": {
      "image": [
        "4",
        0
      ],
      "model": "BiRefNet-general",
      "sensitivity": 1.0,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": false,
      "unload_model": true,
      "background": "Alpha",
      "background_color": "#000000"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "typeset/matte/fg"
    }
  },
  "4": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    }
  },
  "5": {
    "class_type": "MaskToTracks",
    "inputs": {
      "fps": [
        "7",
        0
      ],
      "label": "person",
      "mask": [
        "8",
        1
      ],
      "track_id": "person0",
      "smooth": 3,
      "frame_offset": 0,
      "raw": false
    }
  },
  "6": {
    "class_type": "SaveTextFile",
    "inputs": {
      "text": [
        "5",
        0
      ],
      "filename_prefix": "typeset/matte/tracks",
      "extension": "json"
    }
  },
  "7": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 24.0
    }
  },
  "8": {
    "class_type": "TypesetMatteRefine",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "mask": [
        "2",
        1
      ],
      "max_hole": 0.25,
      "min_speck": 0.002
    },
    "_meta": {
      "title": "fill holes in the subject"
    }
  }
}